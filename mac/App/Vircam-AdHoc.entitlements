<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc builds cannot carry the system-extension entitlement (it needs a provisioning profile). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Ad-hoc signatures have no team ID, so the hardened runtime's library validation
	     rejects the embedded ONNX Runtime dylib. Team-signed builds share a team ID and
	     do not need this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
